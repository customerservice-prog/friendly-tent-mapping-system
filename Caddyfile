# Railpack's static-site defaults, with revalidation for the customer designer.
# https://railpack.com/languages/staticfile/#custom-caddyfile
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	log {
		format json
	}
	respond /health 200
	# Public GA4 config. The measurement ID is not a secret; an unset value leaves analytics disabled.
	@analyticsConfig path /analytics-config.js
	header @analyticsConfig Content-Type "application/javascript; charset=utf-8"
	header @analyticsConfig Cache-Control "no-store"
	respond @analyticsConfig "window.RENTSKETCH_GA4_MEASUREMENT_ID='\{$GA4_MEASUREMENT_ID\}';" 200
	# One public host and one URL per page. Redirects run before file rewrites.
	@www host www.rentsketch.com
	redir @www https://rentsketch.com{uri} permanent
	map {query} {querySuffix} {
		"" ""
		default "?{query}"
	}
	@indexFile path_regexp indexFile ^(.*)/index\.html$
	redir @indexFile {re.indexFile.1}/{querySuffix} permanent
	@partyBusinessAlias path /party-rental-business-software /party-rental-business-software/
	redir @partyBusinessAlias /party-rental-software/{querySuffix} permanent
	@softwareForPartyAlias path /software-for-party-rental /software-for-party-rental/
	redir @softwareForPartyAlias /party-rental-software/{querySuffix} permanent
	@partyEventAlias path /party-event-rental-software /party-event-rental-software/ /party-and-event-rental-software /party-and-event-rental-software/
	redir @partyEventAlias /event-rental-software/{querySuffix} permanent
	@missingSlash path /business /demo /help /privacy /tent-layout-software /tent-diagram-software /party-rental-software /party-rental-inventory-software /party-rental-management-software /event-rental-software /tent-rental-software /event-layout-software /wedding-layout-planner
	redir @missingSlash {path}/{querySuffix} permanent
	@source path /server/* /docs/* /scripts/* /.git* /.env* /STRIPE* /INTEGRATION_HANDOFF.md /FRIENDLY-EVENT-DESIGNER.md
	respond @source 404
	@privatePage path /designer /designer/* /dashboard /dashboard/* /my-event /my-event/* /business/signup* /tests/*
	header @privatePage X-Robots-Tag "noindex, nofollow"
	@marketing path / /index.html /business/* /demo/* /help/* /privacy/* /tent-layout-software/* /tent-diagram-software/* /party-rental-software/* /party-rental-inventory-software/* /party-rental-management-software/* /event-rental-software/* /tent-rental-software/* /event-layout-software/* /wedding-layout-planner/* /marketing* /sitemap.xml /sitemap-software.xml /sitemap-event-planning.xml /robots.txt
	header @marketing Cache-Control "no-cache"
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	# Keep cached copies, but check for updates before starting a new visit.
	# Otherwise Friendly's iframe can retain an older entry page after a deploy.
	@designer path /designer /designer/* /script.js /js/* /embed/* /*.css
	header @designer Cache-Control "no-cache"

	root * /app
	file_server {
		hide .git .env*
	}
	encode gzip zstd
	try_files {path} {path}.html {path}/index.html
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
