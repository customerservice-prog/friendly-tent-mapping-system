# Copy this file to .env and fill in real values. Never commit the real .env.

# Postgres connection string for your database (Render, Railway, Supabase,
# Neon, or your own server all work).
DATABASE_URL=postgres://user:password@host:5432/rentsketch

# Long random string used to sign login tokens. Generate one yourself,
# e.g. `openssl rand -hex 32` - do not reuse this example value.
JWT_SECRET=replace-with-a-long-random-string

# Required for optional authenticator MFA in production. Generate a separate
# 32-byte key: openssl rand -hex 32. Store/back up securely; do not rotate this
# value without migrating encrypted MFA secrets and recovery-code hashes.
# JWT_SECRET can be rotated independently of this key.
MFA_ENCRYPTION_KEY=

# Port the server listens on.
PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=https://rentsketch.com,https://customerservice-prog.github.io

# Stripe TEST or LIVE secret key. Starts with sk_test_ or sk_live_.
# For TEST mode during development, use sk_test_*.
# For LIVE mode, use sk_live_* (requires explicit human approval).
STRIPE_SECRET_KEY=sk_test_replace-with-real-stripe-secret-key

# Stripe webhook signing secret. Used to verify webhook signatures.
# Starts with whsec_test_ or whsec_live_.
STRIPE_WEBHOOK_SECRET=whsec_test_replace-with-real-webhook-secret

# Permanent Stripe Price IDs for business subscriptions.
# These should point to permanent Price IDs created in Stripe dashboard.
# TEST environment examples (replace with LIVE price IDs when ready):
STRIPE_PRICE_STARTER_MONTHLY=price_1UGMtIFhxlZaCpAOu6X6S9AY
STRIPE_PRICE_STARTER_ANNUAL=price_1UGMsnFhxlZaCpAOihLGKKwQ
STRIPE_PRICE_PRO_MONTHLY=price_1UGMtcFhxlZaCpAOOcECbrbP
STRIPE_PRICE_PRO_ANNUAL=price_1UGMswFhxlZaCpAO7NGTqKBC
STRIPE_PRICE_COMMERCE_MONTHLY=price_1UGMtnFhxlZaCpAO3NQ9poAT
STRIPE_PRICE_COMMERCE_ANNUAL=price_1UGMt7FhxlZaCpAO5cubFV0I
